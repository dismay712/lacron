# Copy to .env if you need to customize these defaults.
TZ=Asia/Shanghai
LACRON_PORT=8080
LACRON_MAX_CONCURRENT=4
# Optional: space-separated Alpine packages installed on each container start.
# LACRON_APK_PACKAGES=bash curl jq
# Optional: at least 24 non-whitespace bytes. A random token is generated if empty.
# LACRON_TOKEN=
