# Copy to .env if you need to customize these defaults.
TZ=Asia/Shanghai
LACRON_PORT=8080
# Initial default until settings are saved in the WebUI.
LACRON_MAX_CONCURRENT=4
# Optional: space-separated Alpine packages installed on each container start.
# LACRON_APK_PACKAGES=bash curl jq
# Optional: at least 24 non-whitespace bytes. A random token is generated if empty.
# LACRON_TOKEN=
# Required to save variables or migrate an existing variables.json.
# Generate once with openssl rand -base64 32 and keep it with your backups.
# LACRON_ENCRYPTION_KEY=
# Supply the old key temporarily to rotate an existing key.
# LACRON_PREVIOUS_ENCRYPTION_KEY=
